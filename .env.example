# .env.example
# This file is a template for the environment variables required to run the application in development or production.
# Duplicate this file, rename it to .env or .env.local, and fill in the required values.

# Currently, the application is static and relies on mocked data. 
# No environment variables are strictly required for V1 to function.

# Production Site URL (used for canonical URLs, Open Graph metadata, sitemap, and robots.txt)
NEXT_PUBLIC_SITE_URL="https://triadsfuture.com"

# -------------------------------------------------------------
# CONTACT FORM DELIVERY (Optional)
# -------------------------------------------------------------
# By default, the contact form uses transparent client-side mailto: dispatch to contact@triadsfuture.com.
# If direct server-side delivery is desired for production, configure an email service or webhook:
# FORMSPREE_ENDPOINT="https://formspree.io/f/your-form-id"
# RESEND_API_KEY="re_your_api_key_here"
# CONTACT_NOTIFICATION_EMAIL="contact@triadsfuture.com"

# -------------------------------------------------------------
# FUTURE CONFIGURATION (When backend/CMS features are added)
# -------------------------------------------------------------

# DATABASE_URL="postgresql://user:password@localhost:5432/traids_db"
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

