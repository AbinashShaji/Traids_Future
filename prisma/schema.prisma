generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  blogPosts    BlogPost[]
  media        Media[]
}

model Appointment {
  id                    String   @id @default(cuid())
  name                  String
  phoneNumber           String
  email                 String?
  businessName          String?
  preferredContactMethod String?
  preferredContactTime  String?
  serviceInterest       String?
  message               String?
  status                String   @default("New") // New, Contacted, Meeting Scheduled, Proposal Sent, Won, Closed
  internalNotes         String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Project {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  clientName        String?
  industry          String
  results           Json?
  featured          Boolean  @default(false)
  published         Boolean  @default(false)
  coverImage        String?
  summary           String?  @db.Text
  tags              String[]
  testimonialId     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  metaTitle         String?
  metaDescription   String?
  ogImage           String?
  coverImageAlt     String?
  order             Int      @default(0)
  ctaHeadline       String?
  narrativeSections Json?
  galleryImages     Json?
}

model BlogPost {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  excerpt         String?  @db.Text
  content         String   @db.Text
  category        String?
  featuredImage   String?
  seoTitle        String?
  metaDescription String?  @db.Text
  published       Boolean  @default(false)
  publishedAt     DateTime?
  featured        Boolean  @default(false)
  tags            String[]
  readingTime     Int?
  authorName      String?
  authorRole      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  authorId        String?
  author          Admin?   @relation(fields: [authorId], references: [id])
}

model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  company     String?
  designation String?
  photo       String?
  rating      Int?     @default(5)
  review      String   @db.Text
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FAQ {
  id           String   @id @default(cuid())
  question     String
  answer       String   @db.Text
  category     String?
  displayOrder Int      @default(0)
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Media {
  id           String   @id @default(cuid())
  fileName     String
  url          String
  altText      String?
  fileType     String?
  fileSize     Int?
  createdAt    DateTime @default(now())
  
  uploaderId   String?
  uploader     Admin?   @relation(fields: [uploaderId], references: [id])
}

model WebsiteSettings {
  id                 String   @id @default(cuid()) // Will use a fixed ID like 'singleton'
  companyName        String?
  logo               String?
  favicon            String?
  phone              String?
  email              String?
  address            String?
  businessHours      String?
  facebook           String?
  instagram          String?
  linkedin           String?
  footerText         String?
  updatedAt          DateTime @updatedAt
}
